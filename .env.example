# ══════════════════════════════════════════════════════════════════
# Network Security Monitor — Environment Configuration
# Αντιγράψτε αυτό το αρχείο σε .env και προσαρμόστε τις τιμές
# ══════════════════════════════════════════════════════════════════

# Flask
SECRET_KEY=change-this-to-a-random-secret-key
APP_ENV=development
FLASK_HOST=0.0.0.0
FLASK_PORT=5000
FLASK_DEBUG=false

# JWT Authentication
JWT_SECRET_KEY=change-this-jwt-secret
JWT_EXPIRATION_HOURS=24
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-password

# Fernet key for encrypted user profile data; generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
DATA_ENCRYPTION_KEY=ppFyPCOMTKcwKNpNQNX_ctlKWPDaQ1Mh-gSk5lT0SUM=

# Database
# Για τοπική ανάπτυξη: sqlite:///network_monitor.db
# Για Docker: sqlite:////app/network_monitor.db
DATABASE_URL=sqlite:///network_monitor.db

# Packet Capture
CAPTURE_INTERFACE=
AUTO_START_CAPTURE=false

# Detection Thresholds
PORT_SCAN_THRESHOLD=15
PORT_SCAN_WINDOW_SECONDS=60
BRUTE_FORCE_THRESHOLD=10
BRUTE_FORCE_WINDOW_SECONDS=120
FAILED_LOGIN_THRESHOLD=5
DNS_SUSPICIOUS_QUERY_LENGTH=80

# GeoIP
GEOIP_DB_PATH=data/GeoLite2-Country.mmdb
GEOIP_FALLBACK_API=http://ip-api.com/json/{ip}

# Blacklist
BLACKLIST_FILE=data/blacklist.txt

# Reports
REPORTS_DIR=reports
